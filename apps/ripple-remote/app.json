{
  "expo": {
    "name": "Ripple Remote",
    "slug": "ripple-remote",
    "owner": "rippleworks",
    "version": "0.1.0",
    "scheme": "ripple-remote",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.clauderipple.remote", "supportsTablet": true },
    "plugins": [
      "expo-router", "expo-secure-store", "expo-notifications", "expo-localization", "./plugins/withPodTarget", "./plugins/withSceneLifecycle",
      ["expo-camera", { "cameraPermission": "연결용 QR 코드를 스캔하고, 대화에 첨부할 사진을 찍기 위해 카메라를 사용합니다.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "대화에 첨부할 사진을 고르기 위해 사진 보관함을 사용합니다.", "cameraPermission": "연결용 QR 코드를 스캔하고, 대화에 첨부할 사진을 찍기 위해 카메라를 사용합니다.", "microphonePermission": false }]
    ]
  }
}
